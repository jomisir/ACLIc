# Local development, and for running migrations against the remote database.
#
# In PRODUCTION these are NOT read from a file — they are set in
# cPanel -> Setup Node.js App -> Environment variables. See deploy.md.
# Never commit a filled-in .env* file.

# --- Database (Neon) ---
# Pooled connection string from the Neon dashboard. The app reaches this over
# HTTPS via @neondatabase/serverless; drizzle-kit and pg_dump use 5432, which
# is why migrations and backups run off the shared host.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Local development only. Points the Neon HTTP driver at a proxy that speaks
# the same SQL-over-HTTP protocol in front of a plain local Postgres, so you
# can develop without a Neon account. LEAVE THIS UNSET IN PRODUCTION — unset
# means the real Neon endpoint over HTTPS, which is what you want.
# NEON_FETCH_ENDPOINT=http://127.0.0.1:5599/sql

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://aclic.org

# --- Bootstrap superuser (used by `npm run db:seed`; not needed in production) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=ACLIC Administrator

# --- Supabase Storage (private bucket for photos, logos, resources) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=aclic-media

# --- SMTP (cPanel mailbox on the Yegara mail host) ---
SMTP_HOST=mail.aclic.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ACLIC <no-reply@aclic.org>"
