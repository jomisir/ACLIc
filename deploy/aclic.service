## Alternative to PM2: a systemd unit.
## Install: sudo cp deploy/aclic.service /etc/systemd/system/aclic.service
##          sudo systemctl daemon-reload && sudo systemctl enable --now aclic

[Unit]
Description=ACLIC website (Next.js standalone)
After=network.target

[Service]
Type=simple
User=aclic
WorkingDirectory=/opt/aclic/app
EnvironmentFile=/opt/aclic/app/.env.production
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
